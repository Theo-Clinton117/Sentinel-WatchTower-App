# Use these values when testing the mobile app against the deployed Render backend.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_BASE_URL=https://sentinel-watchtower-backend.onrender.com
EXPO_PUBLIC_WS_URL=https://sentinel-watchtower-backend.onrender.com

# Enable this only when you want the dev-only tester bootstrap in Expo Go.
EXPO_PUBLIC_ENABLE_DEV_TEST_SESSION=true

# Supply this separately if maps are enabled for the build.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
