# Use these values when testing the mobile app against the deployed Render backend.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_BASE_URL=https://sentinel-watchtower-backend.onrender.com
EXPO_PUBLIC_WS_URL=https://sentinel-watchtower-backend.onrender.com
EXPO_PUBLIC_PAYSTACK_CALLBACK_URL=sentinel://payment-success

# Enable this only when you want the dev-only tester bootstrap in Expo Go.
EXPO_PUBLIC_ENABLE_DEV_TEST_SESSION=false

# Required for production Android builds. Restrict this key in Google Cloud to
# the Android Maps SDK, com.sentinel.watchtower, and the release signing SHA-1/SHA-256.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
# iOS uses the native Apple Maps provider and does not require a Google Maps key.
